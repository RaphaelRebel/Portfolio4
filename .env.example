# Database. Leave empty locally to use the local.db file.
# On Vercel: the Turso URL (libsql://...) and a token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Login for /admin. Generate with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob, for uploads in /admin
BLOB_READ_WRITE_TOKEN=

# The public address, used for social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
